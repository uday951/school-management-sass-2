generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserType {
  PLATFORM_SUPER_ADMIN
  SCHOOL_ADMIN
  STUDENT
  GUARDIAN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SchoolStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SchoolType {
  PRIMARY
  SECONDARY
  HIGHER_SECONDARY
  COMBINED
  PRESCHOOL
  INTERNATIONAL
}

enum BoardType {
  CBSE
  ICSE
  STATE
  IB
  CAMBRIDGE
  OTHER
}

model User {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  firstName          String
  lastName           String
  email              String          @unique
  phone              String?
  passwordHash       String
  userType           UserType
  tenantId           String?         @db.ObjectId
  roleId             String?         @db.ObjectId
  status             UserStatus      @default(ACTIVE)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  mustChangePassword Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant             Tenant?         @relation(fields: [tenantId], references: [id])
  role               Role?           @relation(fields: [roleId], references: [id])
  refreshSessions    RefreshSession[]
  employee           Employee?
  student            Student?
  guardian           Guardian?
  importJobs         ImportJob[]
  createdInvites     SchoolInvite[]
  onboardingApplications StudentOnboardingRequest[] @relation("ApplicantRelation")
  onboardingReviews      StudentOnboardingRequest[] @relation("ReviewerRelation")
  childClaims        ChildClaimRequest[]        @relation("GuardianClaimRelation")
  reviewedClaims     ChildClaimRequest[]        @relation("ClaimReviewerRelation")
  requestedCorrections AttendanceCorrectionRequest[] @relation("CorrectionRequester")
  reviewedCorrections  AttendanceCorrectionRequest[] @relation("CorrectionReviewer")

  @@index([tenantId])
  @@index([userType])
  @@index([roleId])
}

model Tenant {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String         @unique
  status        TenantStatus   @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?

  schools       School[]
  users         User[]
  academicYears AcademicYear[]
  departments   Department[]
  gradeLevels   GradeLevel[]
  sections      Section[]
  subjects      Subject[]
  classSubjects ClassSubject[]
  roles         Role[]
  students      Student[]
  enrollments   StudentEnrollment[]
  guardians     Guardian[]
  employees     Employee[]
  employeeDepartments EmployeeDepartment[]
  employeeQualifications EmployeeQualification[]
  employeeExperiences EmployeeExperience[]
  employeeDocuments EmployeeDocument[]
  teacherAssignments TeacherAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  departmentHeadAssignments DepartmentHeadAssignment[]
  importJobs                ImportJob[]
  feeCategories             FeeCategory[]
  feeComponents             FeeComponent[]
  feeStructures             FeeStructure[]
  feeStructureItems         FeeStructureItem[]
  feeStructureTargets       FeeStructureTarget[]
  feeInstallments           FeeInstallment[]
  feeInstallmentItems       FeeInstallmentItem[]
  studentFeeAssignments     StudentFeeAssignment[]
  feeCharges                FeeCharge[]
  concessionSchemes         ConcessionScheme[]
  studentConcessions        StudentConcession[]
  feeAdjustments            FeeAdjustment[]
  payments                  Payment[]
  paymentAllocations        PaymentAllocation[]
  receipts                  Receipt[]
  paymentReversals          PaymentReversal[]
  refundRecords             RefundRecord[]
  financeSettings           FinanceSettings[]
  importRows                ImportRow[]
  schoolInvites             SchoolInvite[]
  onboardingRequests        StudentOnboardingRequest[]
  childClaims               ChildClaimRequest[]
  attendancePolicies        AttendancePolicy[]
  attendanceSessions        AttendanceSession[]
  attendanceRecords         AttendanceRecord[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  attendanceCorrectionItems AttendanceCorrectionItem[]

  staffAttendanceRecords    StaffAttendanceRecord[]
  staffAttendanceSettings   StaffAttendanceSettings[]
  leaveTypes                LeaveType[]
  leavePolicies             LeavePolicy[]
  leavePolicyRules          LeavePolicyRule[]
  leaveBalances             EmployeeLeaveBalance[]
  leaveRequests             LeaveRequest[]
  announcements             Announcement[]
  announcementAudiences     AnnouncementAudience[]
  announcementRecipients    AnnouncementRecipient[]
  notifications             Notification[]
  homeworks                 Homework[]
  assignments               Assignment[]
  assignmentSubmissions     AssignmentSubmission[]
  assignmentGrades          AssignmentGrade[]
  studyMaterials            StudyMaterial[]

  rooms                 Room[]
  workingDays           SchoolWorkingDay[]
  bellSchedules         BellSchedule[]
  bellPeriods           BellPeriod[]
  workingDaySchedules   WorkingDaySchedule[]
  timetables            Timetable[]
  timetableEntries      TimetableEntry[]
  teacherAvailabilities TeacherAvailability[]
  scheduleOverrides     ScheduleOverride[]
  substitutions         Substitution[]

  academicTerms          AcademicTerm[]
  examCycles             ExamCycle[]
  exams                  Exam[]
  examTargets            ExamTarget[]
  examSubjects           ExamSubject[]
  assessmentComponents  AssessmentComponent[]
  gradeScales            GradeScale[]
  gradeBoundaries        GradeBoundary[]
  marksEntries           MarksEntry[]
  marksSubmissions       MarksSubmission[]
  marksCorrectionRequests MarksCorrectionRequest[]
  subjectResults         SubjectResult[]
  studentResults         StudentResult[]
  resultPolicies         ResultPolicy[]
  reportCardTemplates    ReportCardTemplate[]
  reportCards            ReportCard[]
  remarks                StudentExamRemark[]
  coScholasticAreas      CoScholasticArea[]
  coScholasticEntries    CoScholasticEntry[]

  librarySettings             LibrarySettings[]
  bookCategories              BookCategory[]
  authors                     Author[]
  publishers                  Publisher[]
  books                       Book[]
  bookAuthors                 BookAuthor[]
  bookCopies                  BookCopy[]
  libraryLoans                LibraryLoan[]
  libraryFines                LibraryFine[]
  bookReservations            BookReservation[]
  transportSettings           TransportSettings[]
  vehicles                    Vehicle[]
  driverProfiles              DriverProfile[]
  transportRoutes             TransportRoute[]
  transportStops              TransportStop[]
  routeStops                  RouteStop[]
  transportTrips              TransportTrip[]
  studentTransportAssignments StudentTransportAssignment[]
  transportAttendances        TransportAttendance[]
  transportOverrides          TransportOverride[]
  calendarEvents              CalendarEvent[]
  calendarEventAudiences      CalendarEventAudience[]
  workingDayExceptions        WorkingDayException[]
  visitors                    Visitor[]
  visitRecords                VisitRecord[]
  studentGatePasses           StudentGatePass[]

  @@index([status])
}

model School {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String         @db.ObjectId
  name            String
  code            String         @unique
  slug            String         @unique
  schoolType      SchoolType
  board           BoardType
  establishedYear Int?
  officialEmail   String         @unique
  officialPhone   String
  website         String?
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  country         String         @default("India")
  postalCode      String
  logoUrl         String?
  status          SchoolStatus   @default(ONBOARDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  archivedAt      DateTime?

  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  academicYears   AcademicYear[]
  departments     Department[]
  gradeLevels     GradeLevel[]
  sections        Section[]
  subjects        Subject[]
  classSubjects   ClassSubject[]
  roles           Role[]
  students        Student[]
  enrollments     StudentEnrollment[]
  guardians       Guardian[]
  employees       Employee[]
  employeeDepartments EmployeeDepartment[]
  employeeQualifications EmployeeQualification[]
  employeeExperiences EmployeeExperience[]
  employeeDocuments EmployeeDocument[]
  teacherAssignments TeacherAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  departmentHeadAssignments DepartmentHeadAssignment[]
  importJobs                ImportJob[]
  schoolInvites             SchoolInvite[]
  onboardingRequests        StudentOnboardingRequest[]
  attendancePolicies        AttendancePolicy[]
  attendanceSessions        AttendanceSession[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]

  rooms                 Room[]
  bellSchedules         BellSchedule[]
  timetables            Timetable[]
  scheduleOverrides     ScheduleOverride[]

  academicTerms         AcademicTerm[]
  examCycles            ExamCycle[]
  exams                 Exam[]

  @@index([tenantId])
  @@index([status])
  @@index([board])
  @@index([schoolType])
  @@index([createdAt])
}

model RefreshSession {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  actorUserId String   @db.ObjectId
  actorEmail  String
  tenantId    String?  @db.ObjectId
  schoolId    String?  @db.ObjectId
  action      String
  entityType  String
  entityId    String?  @db.ObjectId
  oldValues   Json?
  newValues   Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([tenantId])
  @@index([schoolId])
  @@index([action])
  @@index([createdAt])
}

enum AcademicYearStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

model AcademicYear {
  id         String             @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String             @db.ObjectId
  schoolId   String             @db.ObjectId
  name       String
  code       String?
  startDate  DateTime
  endDate    DateTime
  status     AcademicYearStatus @default(PLANNED)
  isCurrent  Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  archivedAt DateTime?

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  school     School             @relation(fields: [schoolId], references: [id])
  classSubjects ClassSubject[]
  enrollments   StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  invites                 SchoolInvite[]
  onboardingRequests      StudentOnboardingRequest[]
  attendanceSessions      AttendanceSession[]
  timetables              Timetable[]

  academicTerms           AcademicTerm[]
  feeStructures           FeeStructure[]
  feeCharges              FeeCharge[]
  studentConcessions      StudentConcession[]
  payments                Payment[]
  studentFeeAssignments   StudentFeeAssignment[]
  examCycles              ExamCycle[]
  exams                   Exam[]
  coScholasticAreas       CoScholasticArea[]

  homeworks               Homework[]
  assignments             Assignment[]
  studyMaterials          StudyMaterial[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId, schoolId])
}

enum DepartmentType {
  ACADEMIC
  ADMINISTRATIVE
  SUPPORT
  OTHER
}

enum Status {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Department {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String         @db.ObjectId
  schoolId    String         @db.ObjectId
  name        String
  code        String
  type        DepartmentType @default(ACADEMIC)
  description String?
  status      Status         @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  archivedAt  DateTime?

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  school      School         @relation(fields: [schoolId], references: [id])
  subjects    Subject[]
  primaryEmployees Employee[] @relation("PrimaryDepartment")
  employeeDepartments EmployeeDepartment[]
  departmentHeadAssignments DepartmentHeadAssignment[]

  @@unique([tenantId, schoolId, code])
  @@index([tenantId, schoolId])
}

model GradeLevel {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String         @db.ObjectId
  schoolId     String         @db.ObjectId
  name         String
  code         String
  displayOrder Int            @default(0)
  description  String?
  status       Status         @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  archivedAt   DateTime?

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  school       School         @relation(fields: [schoolId], references: [id])
  sections     Section[]
  classSubjects ClassSubject[]
  enrollments   StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  invites                 SchoolInvite[]
  onboardingRequests      StudentOnboardingRequest[]
  attendanceSessions      AttendanceSession[]
  timetables              Timetable[]

  examTargets             ExamTarget[]
  feeStructureTargets     FeeStructureTarget[]
  examSubjects            ExamSubject[]
  marksSubmissions        MarksSubmission[]

  homeworks               Homework[]
  assignments             Assignment[]
  studyMaterials          StudyMaterial[]

  @@unique([tenantId, schoolId, code])
  @@index([tenantId, schoolId])
}

model Section {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String         @db.ObjectId
  schoolId     String         @db.ObjectId
  gradeLevelId String         @db.ObjectId
  name         String
  code         String?
  capacity     Int?
  displayOrder Int            @default(0)
  status       Status         @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  archivedAt   DateTime?

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  school       School         @relation(fields: [schoolId], references: [id])
  gradeLevel   GradeLevel     @relation(fields: [gradeLevelId], references: [id])
  classSubjects ClassSubject[]
  enrollments   StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  invites                 SchoolInvite[]
  onboardingRequests      StudentOnboardingRequest[]
  attendanceSessions      AttendanceSession[]
  timetables              Timetable[]

  examTargets             ExamTarget[]
  feeStructureTargets     FeeStructureTarget[]
  marksSubmissions        MarksSubmission[]

  homeworks               Homework[]
  assignments             Assignment[]
  studyMaterials          StudyMaterial[]

  @@unique([tenantId, schoolId, gradeLevelId, name])
  @@index([tenantId, schoolId])
}

enum SubjectType {
  CORE
  ELECTIVE
  OPTIONAL
  ACTIVITY
  OTHER
}

model Subject {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String         @db.ObjectId
  schoolId     String         @db.ObjectId
  name         String
  code         String
  description  String?
  subjectType  SubjectType    @default(CORE)
  departmentId String?        @db.ObjectId
  status       Status         @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  archivedAt   DateTime?

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  school       School         @relation(fields: [schoolId], references: [id])
  department   Department?    @relation(fields: [departmentId], references: [id])
  classSubjects ClassSubject[]
  teacherAssignments TeacherAssignment[]
  timetableEntries TimetableEntry[]
  scheduleOverrides ScheduleOverride[]

  examSubjects      ExamSubject[]

  homeworks         Homework[]
  assignments       Assignment[]
  studyMaterials    StudyMaterial[]

  @@unique([tenantId, schoolId, code])
  @@index([tenantId, schoolId])
}

model ClassSubject {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String       @db.ObjectId
  schoolId       String       @db.ObjectId
  gradeLevelId   String       @db.ObjectId
  subjectId      String       @db.ObjectId
  academicYearId String       @db.ObjectId
  sectionId      String?      @db.ObjectId
  isMandatory    Boolean      @default(true)
  displayOrder   Int          @default(0)
  status         Status       @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  gradeLevel     GradeLevel   @relation(fields: [gradeLevelId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])

  @@unique([tenantId, schoolId, academicYearId, gradeLevelId, sectionId, subjectId])
  @@index([tenantId, schoolId])
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String?  @db.ObjectId
  schoolId    String?  @db.ObjectId
  name        String
  code        String
  scope       String   @default("SCHOOL")
  isSystem    Boolean  @default(false)
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  school      School?  @relation(fields: [schoolId], references: [id])
  users       User[]

  @@unique([tenantId, schoolId, code])
  @@index([tenantId, schoolId])
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
  TRANSFERRED
  GRADUATED
  ARCHIVED
}

model Student {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String       @db.ObjectId
  schoolId        String       @db.ObjectId
  userId          String?      @unique @db.ObjectId
  admissionNumber String
  studentCode     String?
  firstName       String
  middleName      String?
  lastName        String
  preferredName   String?
  photoUrl        String?
  dateOfBirth     DateTime
  gender          String
  bloodGroup      String?
  nationality     String?
  motherTongue    String?
  personalEmail   String?
  personalPhone   String?
  status          StudentStatus @default(ACTIVE)
  admissionDate   DateTime
  joiningType     String?
  previousSchoolName String?
  previousClassName  String?
  
  // Address info
  currentAddressLine1 String
  currentAddressLine2 String?
  currentCity         String
  currentState        String
  currentCountry      String
  currentPostalCode   String
  
  permanentAddressLine1 String
  permanentAddressLine2 String?
  permanentCity         String
  permanentState        String
  permanentCountry      String
  permanentPostalCode   String
  sameAsCurrentAddress  Boolean @default(true)

  // Emergency / Restricted info
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  allergies                    String?
  medicalNotes                 String?
  specialAssistanceNotes       String?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  archivedAt      DateTime?

  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  school          School       @relation(fields: [schoolId], references: [id])
  enrollments     StudentEnrollment[]
  guardians       StudentGuardian[]
  documents       StudentDocument[]
  user            User?                   @relation(fields: [userId], references: [id])
  childClaims     ChildClaimRequest[]
  attendanceRecords AttendanceRecord[]

  marksEntries          MarksEntry[]
  feeCharges            FeeCharge[]
  studentConcessions    StudentConcession[]
  feeAdjustments        FeeAdjustment[]
  payments              Payment[]
  refundRecords         RefundRecord[]
  studentFeeAssignments StudentFeeAssignment[]
  subjectResults        SubjectResult[]
  overallResults        StudentResult[]
  reportCards           ReportCard[]
  remarks               StudentExamRemark[]
  coScholasticEntries   CoScholasticEntry[]
  assignmentSubmissions AssignmentSubmission[]

  libraryLoans          LibraryLoan[]
  libraryFines          LibraryFine[]
  bookReservations      BookReservation[]
  transportAssignments  StudentTransportAssignment[]
  transportAttendances  TransportAttendance[]
  transportOverrides    TransportOverride[]
  studentGatePasses     StudentGatePass[]

  @@unique([tenantId, schoolId, admissionNumber])
  @@index([tenantId, schoolId])
  @@index([status])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
  CANCELLED
}

model StudentEnrollment {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String           @db.ObjectId
  schoolId       String           @db.ObjectId
  studentId      String           @db.ObjectId
  academicYearId String           @db.ObjectId
  gradeLevelId   String           @db.ObjectId
  sectionId      String           @db.ObjectId
  rollNumber     String?
  enrollmentDate DateTime
  status         EnrollmentStatus @default(ACTIVE)
  isCurrent      Boolean          @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  archivedAt     DateTime?

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  school         School           @relation(fields: [schoolId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  gradeLevel     GradeLevel       @relation(fields: [gradeLevelId], references: [id])
  section        Section          @relation(fields: [sectionId], references: [id])

  marksEntries          MarksEntry[]
  feeCharges            FeeCharge[]
  studentConcessions    StudentConcession[]
  payments              Payment[]
  studentFeeAssignments StudentFeeAssignment[]
  subjectResults        SubjectResult[]
  overallResults        StudentResult[]
  reportCards           ReportCard[]
  remarks               StudentExamRemark[]
  assignmentSubmissions AssignmentSubmission[]

  studentTransportAssignments StudentTransportAssignment[]
  studentGatePasses           StudentGatePass[]

  @@index([tenantId, schoolId])
  @@index([studentId])
  @@index([academicYearId])
}

model Guardian {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String            @db.ObjectId
  schoolId       String            @db.ObjectId
  userId         String?           @unique @db.ObjectId
  firstName      String
  middleName     String?
  lastName       String
  phone          String
  alternatePhone String?
  email          String?
  occupation     String?
  employer       String?
  status         Status            @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  school         School            @relation(fields: [schoolId], references: [id])
  students       StudentGuardian[]
  user           User?             @relation(fields: [userId], references: [id])
  pickupGatePasses StudentGatePass[]

  @@index([tenantId, schoolId])
  @@index([phone])
}

model StudentGuardian {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId               String   @db.ObjectId
  schoolId               String   @db.ObjectId
  studentId              String   @db.ObjectId
  guardianId             String   @db.ObjectId
  relationship           String
  isPrimary              Boolean  @default(false)
  isEmergencyContact     Boolean  @default(false)
  isAuthorizedPickup     Boolean  @default(false)
  receivesAcademicUpdates Boolean  @default(false)
  receivesAttendanceUpdates Boolean @default(false)
  receivesFeeUpdates     Boolean  @default(false)
  hasPortalAccess        Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  student                Student  @relation(fields: [studentId], references: [id])
  guardian               Guardian @relation(fields: [guardianId], references: [id])

  @@unique([tenantId, schoolId, studentId, guardianId])
  @@index([tenantId, schoolId])
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model StudentDocument {
  id                 String                     @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String                     @db.ObjectId
  schoolId           String                     @db.ObjectId
  studentId          String                     @db.ObjectId
  documentType       String
  title              String
  fileUrl            String?
  storageKey         String?
  mimeType           String?
  fileSize           Int?
  issueDate          DateTime?
  expiryDate         DateTime?
  verificationStatus DocumentVerificationStatus @default(PENDING)
  uploadedByUserId   String                     @db.ObjectId
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  archivedAt         DateTime?

  student            Student                    @relation(fields: [studentId], references: [id])

  @@index([tenantId, schoolId])
  @@index([studentId])
}

enum EmployeeType {
  TEACHING
  ADMINISTRATIVE
  SUPPORT
  MANAGEMENT
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERN
  VISITING
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
  RETIRED
  ARCHIVED
}

model Employee {
  id                         String                  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId                   String                  @db.ObjectId
  schoolId                   String                  @db.ObjectId
  userId                     String?                 @unique @db.ObjectId
  employeeNumber             String
  firstName                  String
  middleName                 String?
  lastName                   String
  preferredName              String?
  photoUrl                   String?
