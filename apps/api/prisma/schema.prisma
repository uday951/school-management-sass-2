  createdAt       DateTime                 @default(now())

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  calendarEvent   CalendarEvent            @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([calendarEventId])
}

model WorkingDayException {
  id              String                  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String                  @db.ObjectId
  academicYearId  String                  @db.ObjectId
  date            DateTime
  exceptionType   WorkingDayExceptionType @default(NON_WORKING_DAY)
  reason          String
  calendarEventId String?                 @db.ObjectId
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  calendarEvent   CalendarEvent?          @relation(fields: [calendarEventId], references: [id])

  @@unique([tenantId, date])
  @@index([tenantId])
}

// ==========================================
// PHASE 11: VISITOR MANAGEMENT & GATE PASS
// ==========================================

enum VisitRecordStatus {
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum GatePassRequestType {
  EARLY_EXIT
  TEMPORARY_EXIT
  EMERGENCY_EXIT
  OTHER
}

enum GatePassStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  EXITED
  RETURNED
  CANCELLED
}

model Visitor {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String        @db.ObjectId
  fullName           String
  phone              String?
  identificationType String?
  identificationLast4 String?
  organization       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  visits             VisitRecord[]

  tenant             Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model VisitRecord {
  id                     String            @id @default(auto()) @map("_id") @db.ObjectId
  tenantId               String            @db.ObjectId
  visitorId              String            @db.ObjectId
  visitDate              DateTime          @default(now())
  checkInAt              DateTime          @default(now())
  checkOutAt             DateTime?
  purpose                String
  personToMeetUserId     String?           @db.ObjectId
  personToMeetEmployeeId String?           @db.ObjectId
  badgeNumber            String?
  status                 VisitRecordStatus @default(CHECKED_IN)
  notes                  String?
  createdByUserId        String            @db.ObjectId
  checkedOutByUserId     String?           @db.ObjectId
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  tenant                 Tenant            @relation(fields: [tenantId], references: [id])
  visitor                Visitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([visitorId])
}

model StudentGatePass {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  tenantId            String              @db.ObjectId
  studentId           String              @db.ObjectId
  studentEnrollmentId String              @db.ObjectId
  requestedByUserId   String              @db.ObjectId
  requestType         GatePassRequestType @default(EARLY_EXIT)
  reason              String
  requestedExitAt     DateTime
  expectedReturnAt    DateTime?
  actualExitAt        DateTime?
  actualReturnAt      DateTime?
  pickupGuardianId    String?             @db.ObjectId
  pickupVisitorId     String?             @db.ObjectId
  status              GatePassStatus      @default(PENDING)
  approvedByUserId    String?             @db.ObjectId
  approvedAt          DateTime?
  rejectedByUserId    String?             @db.ObjectId
  rejectedAt          DateTime?
  reviewComment       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  student             Student             @relation(fields: [studentId], references: [id])
  enrollment          StudentEnrollment   @relation(fields: [studentEnrollmentId], references: [id])
  pickupGuardian      Guardian?           @relation(fields: [pickupGuardianId], references: [id])

  @@index([tenantId])
  @@index([studentId])
}
