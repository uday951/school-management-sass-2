# =============================================================
# School Management SaaS - Environment Variables
# =============================================================
# Copy this file to apps/api/.env and fill in real values.
# NEVER commit .env files with real secrets to source control.
# =============================================================

# ---- Application ----
NODE_ENV=development
PORT=3001

# ---- Database ----
# MongoDB connection string (with replica set for transaction support)
# For local Docker: mongodb://admin:adminpassword@localhost:27017/school_mgmt?authSource=admin&replicaSet=rs0
# For MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/school_mgmt?retryWrites=true&w=majority
DATABASE_URL="mongodb://admin:adminpassword@localhost:27017/school_mgmt?authSource=admin&replicaSet=rs0"

# ---- JWT Secrets (generate with: openssl rand -hex 32) ----
JWT_ACCESS_SECRET=replace_with_minimum_32_char_random_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_different_minimum_32_char_random_secret_for_refresh

# ---- JWT Expiry ----
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Frontend URL (for CORS) ----
FRONTEND_URL=http://localhost:5173

# ---- Platform Super Admin Seed ----
# These are used ONLY by the seed command (npm run seed)
# Change these before seeding any non-development environment
SUPER_ADMIN_EMAIL=admin@platform.local
SUPER_ADMIN_PASSWORD=SuperAdmin@2025!
SUPER_ADMIN_FIRST_NAME=Platform
SUPER_ADMIN_LAST_NAME=Admin
